@model IEnumerable<Category>


<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>MyShop – Sklep internetowy</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }

        .category-nav {
            background-color: white;
            border-bottom: 1px solid #dee2e6;
        }

            .category-nav .nav-link {
                color: #495057;
                font-weight: 500;
            }

                .category-nav .nav-link:hover {
                    color: #0d6efd;
                }

        .product-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            height: 100%;
            transition: transform 0.2s;
        }

            .product-card:hover {
                transform: translateY(-4px);
            }

            .product-card img {
                height: 200px;
                object-fit: cover;
            }

        .product-price {
            font-size: 1.25rem;
            font-weight: bold;
            color: #198754;
        }
    </style>
</head>

<body>

    <!-- Nagłówek -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">MyShop</a>
            <span class="text-white">🛒 Koszyk</span>
        </div>
    </nav>

    <!-- Menu kategorii -->
    <nav class="category-nav">
        <div class="container">
            <ul class="nav justify-content-center py-2">
                <li class="nav-item">
                    <a class="nav-link" href="#">Wszystkie</a>
                </li>

                @foreach (var category in Model)
                {
                <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("CategoryFilms", "Films", new { categoryName = @category.Name })"> @category.Name </a>
                </li>
                }

            </ul>
        </div>
    </nav>

    <!-- Produkty -->
    <main class="container py-5">

        @RenderBody()

        
    </main>

    <!-- Stopka -->
    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">
            &copy; 2026 MyShop – Wszystkie prawa zastrzeżone
        </p>
    </footer>

</body>
</html>
